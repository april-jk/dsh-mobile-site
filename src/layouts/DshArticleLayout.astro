---
import Icon from '~/components/common/Icon.astro';

import PageLayout from '~/layouts/PageLayout.astro';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';

interface Props {
  title: string;
  description: string;
  icon?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, icon = 'tabler:file-description', structuredData } = Astro.props;

const metadata: MetaData = { title, description };
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'DSH Mobile Remote',
      item: 'https://dshmobile.online/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: title,
      item: String(getCanonical(Astro.url.pathname)),
    },
  ],
};

const schemas = structuredData
  ? [breadcrumbs, ...(Array.isArray(structuredData) ? structuredData : [structuredData])]
  : [breadcrumbs];
---

<PageLayout metadata={metadata}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </Fragment>
  <article>
    <header class="border-b border-slate-200/80 dark:border-slate-700/60">
      <div class="mx-auto max-w-5xl px-4 py-16 md:px-6 md:py-24">
        <Icon name={icon} class="size-11 text-primary" stroke-width="1.6" />
        <h1 class="mt-8 max-w-[18ch] text-4xl font-bold leading-tight text-slate-950 dark:text-slate-50 md:text-6xl">
          {title}
        </h1>
        <p class="mt-6 max-w-[68ch] text-lg leading-8 text-muted md:text-xl">{description}</p>
      </div>
    </header>
    <div class="mx-auto max-w-5xl px-4 py-14 md:px-6 md:py-20">
      <div class="dsh-article prose prose-lg max-w-none dark:prose-invert">
        <slot />
      </div>
    </div>
  </article>
</PageLayout>

<style is:global>
  .dsh-article h2 {
    margin-top: 3.5rem;
    color: var(--aw-color-text-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: 0;
  }

  .dsh-article h3 {
    color: var(--aw-color-text-heading);
    letter-spacing: 0;
  }

  .dsh-article a {
    color: var(--aw-color-primary);
  }

  .dsh-article a.btn-primary {
    color: rgb(255 255 255);
  }

  .dark .dsh-article a.btn-primary {
    color: rgb(15 20 34);
  }

  .dsh-article pre {
    border: 1px solid rgb(148 163 184 / 0.35);
    border-radius: 0.75rem;
    background: rgb(15 23 42);
    color: rgb(241 245 249);
  }

  .dsh-article img {
    border: 1px solid rgb(148 163 184 / 0.35);
    border-radius: 0.75rem;
  }

  .dsh-article .info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 2rem 0;
  }

  .dsh-article .info-grid > * {
    margin: 0;
    border: 1px solid rgb(148 163 184 / 0.35);
    border-radius: 0.75rem;
    padding: 1.5rem;
    background: rgb(255 255 255 / 0.62);
  }

  .dark .dsh-article .info-grid > * {
    background: rgb(30 41 59 / 0.5);
  }

  @media (max-width: 767px) {
    .dsh-article .info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
