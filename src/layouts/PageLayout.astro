---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { navigationFor } from '~/navigation';
import { localeFromPath, localeAlternates } from '~/data/dsh-site';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  language?: string;
  textDirection?: 'ltr' | 'rtl';
}

const locale = localeFromPath(Astro.url.pathname);
const { metadata, language = locale, textDirection } = Astro.props;
const { headerData, footerData } = navigationFor(locale, Astro.url.pathname);
---

<Layout metadata={metadata} language={language} textDirection={textDirection}>
  <Fragment slot="head">
    {
      localeAlternates(Astro.url.pathname).map(({ lang, href }) => (
        <link rel="alternate" hreflang={lang} href={`https://dshmobile.online${href}`} />
      ))
    }
    <slot name="head" />
  </Fragment>
  <slot name="announcement" />
  <slot name="header">
    <Header locale={locale} {...headerData} isSticky showRssFeed showToggleTheme />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer locale={locale} {...footerData} />
  </slot>
</Layout>
