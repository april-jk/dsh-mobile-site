---
// Font family is self-hosted by Astro's Fonts API.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-dm-sans);
    --aw-font-serif: var(--font-dm-sans);
    --aw-font-heading: var(--font-dm-sans);

    --aw-color-primary: rgb(58 91 220);
    --aw-color-secondary: rgb(37 68 184);
    --aw-color-accent: rgb(58 91 220);

    --aw-color-text-heading: rgb(20 27 45);
    --aw-color-text-default: rgb(33 42 62);
    --aw-color-text-muted: rgb(72 82 105);
    --aw-color-bg-page: rgb(247 249 252);

    --aw-color-bg-page-dark: rgb(15 20 34);

    ::selection {
      background-color: rgb(58 91 220 / 20%);
    }
  }

  .dark {
    --aw-font-sans: var(--font-dm-sans);
    --aw-font-serif: var(--font-dm-sans);
    --aw-font-heading: var(--font-dm-sans);

    --aw-color-primary: rgb(113 139 245);
    --aw-color-secondary: rgb(142 162 247);
    --aw-color-accent: rgb(113 139 245);

    --aw-color-text-heading: rgb(244 247 252);
    --aw-color-text-default: rgb(222 228 240);
    --aw-color-text-muted: rgb(167 178 202);
    --aw-color-bg-page: rgb(15 20 34);

    ::selection {
      background-color: rgb(113 139 245 / 35%);
      color: rgb(244 247 252);
    }
  }
</style>
