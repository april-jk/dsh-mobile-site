---
import DshLanding from '~/components/dsh/DshLanding.astro';
import PageLayout from '~/layouts/PageLayout.astro';
import { faqs } from '~/data/dsh-site';

const metadata = {
  title: 'DSH Mobile Remote | DeepSeek Harness on Android',
  ignoreTitleTemplate: true,
  description:
    'Open your local DeepSeek Harness Web UI from a paired Android phone, submit normal DSH tasks, or connect through your own Relay.',
};

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'DSH Mobile Remote',
    alternateName: 'DSH Remote',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Android 8.0 or newer',
    url: 'https://dshmobile.online/',
    downloadUrl: 'https://github.com/april-jk/dsh-mobile-suite/releases/latest',
    codeRepository: 'https://github.com/april-jk/dsh-mobile-suite',
    license: 'https://opensource.org/license/mit',
    isAccessibleForFree: true,
    offers: {
      '@type': 'Offer',
      price: 0,
      priceCurrency: 'USD',
    },
    description: metadata.description,
    author: {
      '@type': 'Organization',
      name: 'DSH Mobile community',
      url: 'https://github.com/april-jk/dsh-mobile-suite',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.en.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<PageLayout metadata={metadata}>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href="https://dshmobile.online/" />
    <link rel="alternate" hreflang="zh-CN" href="https://dshmobile.online/zh-cn/" />
    <link rel="alternate" hreflang="x-default" href="https://dshmobile.online/" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>
  <DshLanding locale="en" />
</PageLayout>
