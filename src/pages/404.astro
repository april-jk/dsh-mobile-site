---
import Icon from '~/components/common/Icon.astro';

import Layout from '~/layouts/PageLayout.astro';
---

<Layout metadata={{ title: 'Page not found', robots: { index: false, follow: true } }}>
  <section class="mx-auto flex min-h-[70dvh] max-w-3xl flex-col items-start justify-center px-4 py-20 md:px-6">
    <Icon name="tabler:route-off" class="size-12 text-primary" stroke-width="1.6" />
    <p class="mt-8 font-mono text-sm text-muted">404</p>
    <h1 class="mt-3 text-4xl font-bold text-slate-950 dark:text-slate-50 md:text-5xl">This page is not paired</h1>
    <p class="mt-5 max-w-[54ch] text-lg leading-8 text-muted">
      The address may have changed. Return to DSH Mobile Remote or open the installation guide.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn-primary">Home</a>
      <a href="/download/" class="btn-secondary">Download</a>
    </div>
  </section>
</Layout>
